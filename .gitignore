# Python leftovers -- stuff Python builds automatically, we don't need to save it
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Files your computer's operating system makes on its own
.DS_Store
Thumbs.db

# Folders your code editor makes for its own settings
.vscode/
.idea/

# Leftovers from building the ESP32 controller firmware
firmware/build/
*.hex
*.elf
.pio/

# Leftovers from building the downloadable app with build_app.py --
# these are the FINISHED apps and PyInstaller's scratch files. We don't
# save them here because .github/workflows/release.yml rebuilds fresh
# ones automatically every time we tag a new version.
build/
dist/
*.spec

# Your saved high score, leaderboard, and last-used team/track/mode --
# this is YOUR personal save data, made the first time you play, not
# something the project ships with
high_score.json

# Leftovers from running the pytest suite in tests/
.pytest_cache/

# graphify -- a generated map of the code (report/HTML/cache), can be rebuilt any time
graphify-out/
